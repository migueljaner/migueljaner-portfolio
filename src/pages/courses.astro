---
import BaseLayout from "../layouts/BaseLayout.astro";
import data from "../content/data/courses.json";

const { courses, studies } = data;
---

<BaseLayout
  title="Learning"
  description="Courses I've completed and formal education background."
>
  <!-- Page header -->
  <section class="max-w-4xl mx-auto px-6 pt-28 pb-4">
    <div class="mb-2">
      <h1 class="text-4xl font-bold tracking-tight mb-2">Learning</h1>
      <p class="font-mono text-sm" style="color: var(--muted);">Courses and education.</p>
    </div>
  </section>

  <!-- Courses section -->
  <section class="courses-section max-w-4xl mx-auto px-6 py-10 border-t" style="border-color: var(--border);">
    <p class="font-mono text-xs uppercase tracking-widest mb-8" style="color: var(--muted);">// COURSES</p>

    <div id="courses-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {courses.map((course) => (
        <article
          class="course-card flex flex-col gap-3 p-5 rounded-lg border"
        >
          <!-- Title row -->
          <div class="flex items-start justify-between gap-3">
            <h2 class="text-base font-semibold leading-snug">
              {course.url ? (
                <a
                  href={course.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:opacity-60 transition-opacity"
                  style="text-decoration: underline; text-underline-offset: 3px;"
                >
                  {course.title}
                </a>
              ) : (
                course.title
              )}
            </h2>
            {course.completed && (
              <span class="tag shrink-0">completed</span>
            )}
          </div>

          <!-- Meta row -->
          <div class="flex items-center justify-between gap-2 mt-auto">
            <p class="text-sm" style="color: var(--muted);">
              {course.author}
              <span class="font-mono text-xs mx-1" style="color: var(--border);">/</span>
              {course.platform}
            </p>
            <span class="font-mono text-xs shrink-0" style="color: var(--muted);">{course.year}</span>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Education section -->
  <section class="education-section max-w-4xl mx-auto px-6 py-10 border-t" style="border-color: var(--border);">
    <p class="font-mono text-xs uppercase tracking-widest mb-8" style="color: var(--muted);">// EDUCATION</p>

    <ol class="flex flex-col gap-0 border-l pl-6 md:pl-8" style="border-color: var(--border);">
      {studies.map((study) => (
        <li class="education-entry relative pb-10 last:pb-0">
          <!-- Timeline dot -->
          <span
            class="absolute -left-[calc(1.5rem+1px)] md:-left-[calc(2rem+1px)] top-1 w-2.5 h-2.5 rounded-full border-2 shrink-0"
            style="background: var(--bg); border-color: var(--fg);"
            aria-hidden="true"
          ></span>

          <!-- Year range -->
          <span class="font-mono text-xs block mb-2" style="color: var(--muted);">
            {study.start}–{study.end}
          </span>

          <!-- Degree + field -->
          <p class="font-semibold text-base leading-snug mb-1">
            {study.degree} — {study.field}
          </p>

          <!-- Institution + location -->
          <p class="text-sm mb-4" style="color: var(--muted);">
            {study.institution}
            <span class="font-mono text-xs mx-1" style="color: var(--border);">/</span>
            {study.location}
          </p>

          <!-- Modules as tags -->
          {study.modules && study.modules.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {study.modules.map((mod) => (
                <span class="tag">{mod}</span>
              ))}
            </div>
          )}
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  gsap.from("#courses-grid > .course-card", {
    opacity: 0,
    y: 24,
    duration: 0.55,
    stagger: 0.08,
    ease: "power2.out",
  });

  // ScrollTrigger fade-up on education entries
  const eduEntries = document.querySelectorAll<HTMLElement>(".education-entry");
  eduEntries.forEach((entry) => {
      gsap.from(entry, {
      opacity: 0,
      y: 24,
      duration: 0.55,
      ease: "power2.out",
      scrollTrigger: {
        trigger: entry,
        start: "top 95%",
        once: true,
      }
    });
  });
</script>

<style>
  .course-card {
    background: var(--card-bg);
    border-color: var(--border);
  }
  .course-card:hover {
    border-color: var(--border-hover);
    transform: translateY(-3px);
  }
</style>
