---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ProjectFilter from "../components/ProjectFilter.astro";
import projects from "../content/data/projects.json";

const types = [...new Set(projects.map((p) => p.type))];
const tags = [...new Set(projects.flatMap((p) => p.tags))];
---

<BaseLayout
  title="Projects"
  description="A collection of things I've built — work projects, personal experiments, and open source."
>
  <section class="max-w-4xl mx-auto px-6 pt-28 pb-20">
    <!-- Page header -->
    <div class="mb-10">
      <h1 class="text-4xl font-bold tracking-tight mb-2">Projects</h1>
      <p class="font-mono text-sm" style="color: var(--muted);">Things I've built.</p>
    </div>

    <!-- Filter bar -->
    <ProjectFilter types={types} tags={tags} />

    <!-- Cards grid -->
    <div
      id="projects-grid"
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
    >
      {projects.map((p) => (
        <div data-project-type={p.type} data-project-tags={p.tags.join(",")}>
          <ProjectCard
            title={p.title}
            description={p.description}
            tags={p.tags}
            url={p.url}
            github={p.github}
            image={p.image}
            type={p.type}
          />
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const cards = document.querySelectorAll<HTMLElement>("#projects-grid > [data-project-type]");

  // Cards above or near the fold animate on load via a stagger
  gsap.from(cards, {
    y: 24,
    opacity: 0,
    duration: 0.55,
    ease: "power2.out",
    stagger: 0.08,
    clearProps: "all",
    scrollTrigger: {
      trigger: "#projects-grid",
      start: "top 90%",
      once: true,
    },
  });
</script>
