---
import BaseLayout from "../../layouts/BaseLayout.astro";
import projects from "../../content/data/projects.json";

export async function getStaticPaths() {
  return projects
    .filter((p) => p.slug)
    .map((p) => ({
      params: { slug: p.slug },
      props: { project: p },
    }));
}

const { project } = Astro.props;
const gallery = project.gallery ?? [];
const notes = project.notes ?? [];
---

<BaseLayout
  title={project.title}
  description={project.description}
  image={project.image}
>
  <article class="max-w-3xl mx-auto px-6 pt-28 pb-20">
    <!-- Back link -->
    <a
      href="/projects"
      class="inline-flex items-center gap-1.5 font-mono text-sm mb-10 hover:opacity-70 transition-opacity"
      style="color: var(--muted);"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m15 18-6-6 6-6" />
      </svg>
      Projects
    </a>

    <!-- Header -->
    <header class="mb-8" data-reveal>
      <div class="flex items-start justify-between gap-4 mb-3">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight leading-tight">
          {project.title}
        </h1>
        <div class="flex items-center gap-3 shrink-0 pt-1">
          {
            project.github && (
              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="GitHub repository"
                class="hover:opacity-70 transition-opacity"
                style="color: var(--muted);"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
                </svg>
              </a>
            )
          }
          <a
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Visit live project"
            class="hover:opacity-70 transition-opacity"
            style="color: var(--muted);"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <polyline points="15 3 21 3 21 9" />
              <line x1="10" y1="14" x2="21" y2="3" />
            </svg>
          </a>
        </div>
      </div>
      <p class="text-base leading-relaxed mb-4" style="color: var(--muted);">
        {project.description}
      </p>
      <div class="flex flex-wrap gap-1.5">
        {project.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </header>

    <!-- Hero image -->
    <div class="rounded-lg overflow-hidden border mb-10" style="border-color: var(--border);" data-reveal>
      <img src={project.image} alt={project.title} class="w-full h-auto" loading="eager" />
    </div>

    <!-- Architecture -->
    {
      project.architecture && (
        <section class="mb-10" data-reveal>
          <h2 class="text-xl font-bold tracking-tight mb-3">Architecture</h2>
          <p class="text-base leading-relaxed" style="color: var(--fg);">
            {project.architecture}
          </p>
        </section>
      )
    }

    <!-- Packages -->
    {
      project.packages && project.packages.length > 0 && (
        <section class="mb-10" data-reveal>
          <h2 class="text-xl font-bold tracking-tight mb-3">Packages Used</h2>
          <div class="flex flex-wrap gap-1.5">
            {project.packages.map((pkg) => <span class="tag">{pkg}</span>)}
          </div>
        </section>
      )
    }

    <!-- Notes -->
    {
      notes.length > 0 && (
        <section class="mb-10" data-reveal>
          <h2 class="text-xl font-bold tracking-tight mb-3">Notes</h2>
          <div class="flex flex-col gap-5">
            {notes.map((note) => (
              <div class="rounded-lg border p-5" style="background: var(--card-bg); border-color: var(--border);">
                <h3 class="font-semibold text-sm mb-2">{note.title}</h3>
                <p class="text-sm leading-relaxed" style="color: var(--muted);">
                  {note.body}
                </p>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <!-- Gallery -->
    {
      gallery.length > 0 && (
        <section data-reveal>
          <h2 class="text-xl font-bold tracking-tight mb-3">Gallery</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {gallery.map((src) => (
              <div class="rounded-lg overflow-hidden border" style="border-color: var(--border);">
                <img src={src} alt={project.title} class="w-full h-auto" loading="lazy" />
              </div>
            ))}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const items = document.querySelectorAll<HTMLElement>("[data-reveal]");

  gsap.from(items, {
    y: 20,
    opacity: 0,
    duration: 0.5,
    ease: "power2.out",
    stagger: 0.08,
    clearProps: "all",
    scrollTrigger: {
      trigger: items[0],
      start: "top 90%",
      once: true,
    },
  });
</script>
