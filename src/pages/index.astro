---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import BlogCard from "../components/BlogCard.astro";
import site from "../content/data/site.json";
import allProjects from "../content/data/projects.json";
import { getCollection, type CollectionEntry } from "astro:content";
import { readingTime } from "../utils/readingTime";

const featuredProjects = allProjects.filter((p) => p.featured);

const allPosts = await getCollection(
  "blog",
  ({ data }: CollectionEntry<"blog">) => !data.draft,
);
const latestPosts = allPosts
  .sort(
    (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
      b.data.date.getTime() - a.data.date.getTime(),
  )
  .slice(0, 3);
---

<BaseLayout title="Home" description={site.meta.description}>
  <section class="max-w-4xl mx-auto px-6 py-20">
    <div
      class="hero-content flex flex-col md:flex-row md:items-center gap-10 md:gap-16"
    >
      <div class="flex-1 flex flex-col gap-5">
        <h1
          class="text-5xl sm:text-7xl lg:text-8xl font-black tracking-tight leading-none"
        >
          {site.name}
        </h1>
        <p
          class="font-mono text-xs tracking-widest uppercase mt-1"
          style="color: var(--muted);"
        >
          {site.title}
        </p>
        <p
          class="text-base leading-relaxed max-w-prose"
          style="color: var(--muted);"
        >
          {site.bio}
        </p>
        <div class="flex flex-wrap items-center gap-4 pt-1">
          <a
            href={site.contact.github}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 text-sm font-mono hover:opacity-60 transition-opacity"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"
              ></path>
            </svg>
            GitHub
          </a>
          <a
            href={site.contact.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 text-sm font-mono hover:opacity-60 transition-opacity"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path>
            </svg>
            LinkedIn
          </a>
          <a
            href={`mailto:${site.contact.email}`}
            class="flex items-center gap-2 text-sm font-mono hover:opacity-60 transition-opacity"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            Email
          </a>
        </div>
      </div>
      <div class="shrink-0">
        <img
          src={site.avatar}
          alt={site.name}
          width="160"
          height="160"
          class="rounded-full object-cover border-2"
          style="border-color: var(--border); width: 160px; height: 160px;"
        />
      </div>
    </div>
  </section>

  <section
    class="projects-section max-w-4xl mx-auto px-6 py-16 border-t"
    style="border-color: var(--border);"
  >
    <div class="flex items-center justify-between mb-10">
      <div>
        <p
          class="font-mono text-xs uppercase tracking-widest mb-2"
          style="color: var(--muted);"
        >
          Selected work
        </p>
        <h2 class="text-2xl font-bold">Projects</h2>
      </div>
      <a
        href="/projects"
        class="font-mono text-sm hover:opacity-60 transition-opacity"
        style="color: var(--muted);"
      >
        View all →
      </a>
    </div>
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5"
      id="projects-grid"
    >
      {
        featuredProjects.map((project) => (
          <ProjectCard
            title={project.title}
            description={project.description}
            tags={project.tags}
            url={project.url}
            github={project.github}
            image={project.image}
            type={project.type}
          />
        ))
      }
    </div>
  </section>

  <section
    class="blog-section max-w-4xl mx-auto px-6 py-16 border-t"
    style="border-color: var(--border);"
  >
    <div class="flex items-center justify-between mb-10">
      <div>
        <p
          class="font-mono text-xs uppercase tracking-widest mb-2"
          style="color: var(--muted);"
        >
          Recent posts
        </p>
        <h2 class="text-2xl font-bold">Writing</h2>
      </div>
      <a
        href="/blog"
        class="font-mono text-sm hover:opacity-60 transition-opacity"
        style="color: var(--muted);"
      >
        View all →
      </a>
    </div>
    {
      latestPosts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5" id="blog-grid">
          {latestPosts.map((post: CollectionEntry<"blog">) => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              tags={post.data.tags}
              slug={post.id}
              readingTime={readingTime(post.body ?? "")}
            />
          ))}
        </div>
      ) : (
        <p class="font-mono text-sm" style="color: var(--muted);">
          No posts yet. Check back soon.
        </p>
      )
    }
  </section>
</BaseLayout>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  gsap.from(".hero-content > *", {
    opacity: 0,
    y: 20,
    duration: 0.6,
    stagger: 0.1,
    ease: "power2.out",
  });

  const projectCards = document.querySelectorAll("#projects-grid");
  if (projectCards.length) {
    gsap.from(projectCards, {
      opacity: 0,
      y: 40,
      duration: 0.6,
      ease: "power2.out",
      scrollTrigger: {
        trigger: ".projects-section",
        start: "top 70%",
        once: true,
      },
    });
  }

  const blogCards = document.querySelectorAll("#blog-grid");
  if (blogCards.length) {
    gsap.from(blogCards, {
      opacity: 0,
      y: 40,
      duration: 0.6,
      ease: "power2.out",
      stagger: 0.08,
      scrollTrigger: {
        trigger: ".blog-section",
        start: "top 85%",
        once: true,
      },
    });
  }
</script>
