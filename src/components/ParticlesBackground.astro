---

---

<canvas id="trail-canvas" aria-hidden="true" transition:persist="trail-canvas">
</canvas>
<div
  id="particles-js"
  aria-hidden="true"
  transition:persist="particles-background"
>
</div>

<style>
  #particles-js {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  #particles-js :global(canvas) {
    display: block;
  }

  #trail-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
    pointer-events: none;
  }
</style>

<script is:inline src="/vendor/particles.js"></script>

<script>
  type ParticlesGlobal = typeof window & {
    particlesJS?: (id: string, config: Record<string, unknown>) => void;
    pJSDom?: Array<{
      pJS: {
        particles: {
          color: { value: string };
          line_linked: {
            color: string;
            color_rgb_line?: { r: number; g: number; b: number };
          };
          array: Array<{
            color: {
              value: string;
              rgb?: { r: number; g: number; b: number };
            };
          }>;
        };
        interactivity: {
          events: {
            onhover: { enable: boolean };
            onclick: { enable: boolean };
          };
        };
        fn: { vendors: { destroypJS: () => void } };
      };
    }>;
    __particlesBackgroundObserver?: MutationObserver;
    __particlesInteractivityBound?: boolean;
  };

  function readColor(variable: string, fallback: string) {
    const value = getComputedStyle(document.documentElement)
      .getPropertyValue(variable)
      .trim();
    return value || fallback;
  }

  function buildConfig() {
    const isDark = document.documentElement.classList.contains("dark");
    const particleColor = readColor("--fg", isDark ? "#fafafa" : "#09090b");
    const lineColor = readColor(
      "--border-hover",
      isDark ? "#52525b" : "#a1a1aa",
    );
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    return {
      particles: {
        number: {
          value: 200,
          density: { enable: true, value_area: 800 },
        },
        color: { value: particleColor },
        shape: { type: "circle" },
        opacity: {
          value: 0.6,
          random: true,
          anim: { enable: false },
        },
        size: {
          value: 2.5,
          random: true,
          anim: { enable: false },
        },
        line_linked: {
          enable: true,
          distance: 150,
          color: lineColor,
          opacity: 0.5,
          random: true,
          width: 1,
        },
        move: {
          enable: !reduceMotion,
          speed: 1.2,
          direction: "none",
          random: false,
          straight: false,
          out_mode: "out",
          bounce: false,
        },
      },
      interactivity: {
        detect_on: "window",
        events: {
          onhover: { enable: true, mode: "grab" },
          onclick: { enable: false},
          resize: true,
        },
        modes: {
          grab: {
            distance: 100,
            line_linked: {
              opacity: 1,
            },
          },
          push: {
            particles_nb: 2,
          },
        },
      },
      retina_detect: true,
    };
  }

  function hexToRgb(hex: string) {
    const normalized = hex.replace("#", "");
    const value =
      normalized.length === 3
        ? normalized
            .split("")
            .map((char) => char + char)
            .join("")
        : normalized;
    const int = Number.parseInt(value, 16);

    return {
      r: (int >> 16) & 255,
      g: (int >> 8) & 255,
      b: int & 255,
    };
  }

  function getThemeColors() {
    const isDark = document.documentElement.classList.contains("dark");
    return {
      particleColor: readColor("--fg", isDark ? "#fafafa" : "#09090b"),
      lineColor: readColor("--border-hover", isDark ? "#52525b" : "#a1a1aa"),
    };
  }

  function getParticlesInstance() {
    const pjs = window as ParticlesGlobal;
    return pjs.pJSDom?.[0]?.pJS;
  }

  function applyThemeColors() {
    const instance = getParticlesInstance();
    if (!instance) return;

    const { particleColor, lineColor } = getThemeColors();
    const particleRgb = hexToRgb(particleColor);

    instance.particles.color.value = particleColor;
    instance.particles.line_linked.color = lineColor;
    instance.particles.line_linked.color_rgb_line = hexToRgb(lineColor);
    instance.particles.array.forEach((particle) => {
      particle.color.value = particleColor;
      particle.color.rgb = particleRgb;
    });
  }

  function initParticles() {
    const pjs = window as ParticlesGlobal;
    if (!pjs.particlesJS || !document.getElementById("particles-js")) return;
    if (getParticlesInstance()) {
      applyThemeColors();
      return;
    }

    pjs.particlesJS("particles-js", buildConfig());
  }

  initParticles();

  const pjsInteractivity = window as ParticlesGlobal;
  if (!pjsInteractivity.__particlesInteractivityBound) {
    pjsInteractivity.__particlesInteractivityBound = true;

    const canvas = document.getElementById(
      "trail-canvas",
    ) as HTMLCanvasElement | null;
    const ctx = canvas?.getContext("2d") ?? null;

    let dpr = Math.min(window.devicePixelRatio || 1, 2);
    function resizeTrailCanvas() {
      if (!canvas) return;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.floor(window.innerWidth * dpr);
      canvas.height = Math.floor(window.innerHeight * dpr);
    }
    resizeTrailCanvas();
    window.addEventListener("resize", resizeTrailCanvas);

    // Previous cursor position; null breaks the line (e.g. over a panel).
    let lastX: number | null = null;
    let lastY: number | null = null;

    window.addEventListener(
      "mousemove",
      (event) => {
        const el = document.elementFromPoint(event.clientX, event.clientY);
        const overPanel = !!el?.closest("main > *, footer, header#nav");

        const instance = getParticlesInstance();
        if (instance) {
          instance.interactivity.events.onhover.enable = !overPanel;
          instance.interactivity.events.onclick.enable = !overPanel;
        }

        if (overPanel) {
          lastX = null;
          lastY = null;
          return;
        }

        // Draw the new segment solidly; the rAF loop fades it over time.
        if (ctx && lastX !== null && lastY !== null) {
          const { r, g, b } = hexToRgb(readColor("--opposite-bg", "#fafafa"));
          ctx.globalCompositeOperation = "source-over";
          ctx.strokeStyle = `rgba(${r}, ${g}, ${b}, 0.9)`;
          ctx.lineWidth = 4 * dpr;
          ctx.lineCap = "round";
          ctx.lineJoin = "round";
          ctx.beginPath();
          ctx.moveTo(lastX * dpr, lastY * dpr);
          ctx.lineTo(event.clientX * dpr, event.clientY * dpr);
          ctx.stroke();
        }
        lastX = event.clientX;
        lastY = event.clientY;
      },
      { passive: true },
    );

    document.addEventListener("mouseleave", () => {
      lastX = null;
      lastY = null;
    });

    // Each frame, gently erase the whole canvas so the trail fades away.
    function drawTrail() {
      if (ctx && canvas) {
        ctx.globalCompositeOperation = "destination-out";
        ctx.fillStyle = "rgba(0, 0, 0, 0.2)";
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.globalCompositeOperation = "source-over";
      }
      requestAnimationFrame(drawTrail);
    }
    requestAnimationFrame(drawTrail);
  }

  const pjs = window as ParticlesGlobal;
  if (!pjs.__particlesBackgroundObserver) {
    // Recolor the current particle field without regenerating random positions.
    pjs.__particlesBackgroundObserver = new MutationObserver((mutations) => {
      for (const mutation of mutations) {
        if (mutation.attributeName === "class") {
          applyThemeColors();
          break;
        }
      }
    });
    pjs.__particlesBackgroundObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    });
  }
</script>
