---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Nav from "../components/Nav.astro";
import ParticlesBackground from "../components/ParticlesBackground.astro";
import site from "../content/data/site.json";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = site.meta.description,
  image = "/images/profile.jpg",
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : site.name;
const canonicalURL = new URL(Astro.url.pathname, site.meta.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, site.meta.url)} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, site.meta.url)} />

    <script is:inline>
      function applyTheme(root) {
        const theme = localStorage.getItem("theme") ?? "dark";
        root.classList.remove("light", "dark");
        root.classList.add(theme);
      }
      applyTheme(document.documentElement);
      document.addEventListener("astro:before-swap", (event) => {
        applyTheme(event.newDocument.documentElement);
      });
    </script>
    <ClientRouter />
  </head>
  <body>
    <ParticlesBackground />
    <Nav />
    <main>
      <slot />
    </main>
    <footer>
      <div class="max-w-4xl mx-auto px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 border-t" style="border-color: var(--border);">
        <span class="font-mono text-sm" style="color: var(--muted);">
          &copy; {new Date().getFullYear()} {site.name}
        </span>
        <div class="flex items-center gap-6">
          <a href={site.contact.github} target="_blank" rel="noopener noreferrer" class="text-sm hover:opacity-70 transition-opacity font-mono" style="color: var(--muted);">
            GitHub
          </a>
          <a href={site.contact.linkedin} target="_blank" rel="noopener noreferrer" class="text-sm hover:opacity-70 transition-opacity font-mono" style="color: var(--muted);">
            LinkedIn
          </a>
          <a href={`mailto:${site.contact.email}`} class="text-sm hover:opacity-70 transition-opacity font-mono" style="color: var(--muted);">
            Email
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
